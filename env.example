# Rekuway Face ID — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://rekuway:YOUR_PASSWORD@127.0.0.1:5432/rekuway_faceid

# ─── Authentication ────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-at-least-32-chars

# ─── Facial Verification Provider ─────────────────────────────────────────
# NOT_CONFIGURED | aws-rekognition | iproov | yoti | incode
FACIAL_PROVIDER=NOT_CONFIGURED

NODE_ENV=development
